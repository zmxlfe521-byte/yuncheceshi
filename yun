name: 构建晕不晕 APKon:  workflow_dispatch:jobs:  build:    runs-on: ubuntu-latest    steps:      - uses: actions/checkout@v4      - uses: actions/setup-java@v4        with:          java-version: '17'          distribution: 'temurin'      - name: 解压工程并编译        run: |          unzip -q MotionSickness.zip -d project          cd project/MotionSickness          gradle wrapper --gradle-version 8.2 --distribution-type bin          chmod +x gradlew          ./gradlew assembleDebug --no-daemon --stacktrace      - uses: actions/upload-artifact@v4        with:          name: 晕不晕-debug-apk          path: project/MotionSickness/app/build/outputs/apk/debug/*.apk          retention-days: 30          if-no-files-found: error
